<?xml version='1.0'?>
<?xml-stylesheet type="text/xsl" href="{{slapStaticURL}}xsl/Capabilities.xsl"?>
<vosi:capabilities
  xmlns:vosi="http://www.ivoa.net/xml/VOSICapabilities/v1.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:vs="http://www.ivoa.net/xml/VODataService/v1.1"
  xsi:schemaLocation="http://www.ivoa.net/xml/VOSICapabilities/v1.0 http://vamdc.eu/downloads/xml/VOSI-capabilities-1.0.xsd
  http://www.ivoa.net/xml/VODataService/v1.1 http://www.ivoa.net/xml/VODataService/v1.1">

  <capability>
    <interface xsi:type="vs:ParamHTTP" role="std">
      <accessURL use="full">{{accessURL}}capabilities</accessURL>
    </interface>
  </capability>

  <capability>
    <interface xsi:type="vs:ParamHTTP" role="std">
      <accessURL use="full">{{accessURL}}availability</accessURL>
    </interface>
  </capability>

  <capability standardID="ivo://ivoa.net/std/SLAP#species-2.0">
    <interface xsi:type="vs:ParamHTTP" role="std" version="2.0">
      <accessURL use="base">{{accessURL}}species?</accessURL>
      <queryType>GET</queryType>
      <resultType>application/x-votable+xml</resultType>
      {% for param in species_params %}
      <param use="{{ param.use }}" std="{{ param.std }}">
        <name>{{ param.name }}</name>
        <description>{{ param.description }}</description>
        {% if param.unit %}<unit>{{ param.unit }}</unit>{% endif %}
        {% if param.ucd %}<ucd>{{ param.ucd }}</ucd>{% endif %}
        <dataType{% if param.arraysize %} arraysize="{{ param.arraysize }}"{% endif %}>{{ param.dataType }}</dataType>
      </param>
      {% endfor %}
    </interface>
  </capability>

  <capability standardID="ivo://ivoa.net/std/SLAP#lines-2.0">
    <interface xsi:type="vs:ParamHTTP" role="std" version="2.0">
      <accessURL use="base">{{accessURL}}lines?</accessURL>
      <queryType>GET</queryType>
      <resultType>application/x-votable+xml</resultType>
      {% for param in lines_params %}
      <param use="{{ param.use }}" std="{{ param.std }}">
        <name>{{ param.name }}</name>
        <description>{{ param.description }}</description>
        {% if param.unit %}<unit>{{ param.unit }}</unit>{% endif %}
        {% if param.ucd %}<ucd>{{ param.ucd }}</ucd>{% endif %}
        <dataType{% if param.arraysize %} arraysize="{{ param.arraysize }}"{% endif %}>{{ param.dataType }}</dataType>
      </param>
      {% endfor %}
    </interface>
  </capability>

</vosi:capabilities>
